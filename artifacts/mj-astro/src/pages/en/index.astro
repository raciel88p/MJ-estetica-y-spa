---
import Layout from '../../layouts/Layout.astro';
import Home from '../../components/pages/home';
import { sanityClient } from "sanity:client";

const latestPosts = await sanityClient.fetch(`*[_type == "post" && language == "en"] | order(publishedAt desc)[0...3] {
  ...,
  author->
}`);
---
<Layout lang="en">
  <Home client:load lang="en" latestPosts={latestPosts} />
</Layout>

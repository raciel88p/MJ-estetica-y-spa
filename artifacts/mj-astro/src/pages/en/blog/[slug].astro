---
import Layout from "@/layouts/Layout.astro";
import { sanityClient } from "sanity:client";
import { urlFor } from "@/sanity/lib/image";
import { SEO } from "@/components/SEO";
import PortableText from "@/components/blog/PortableText.astro";

export async function getStaticPaths() {
  const posts = await sanityClient.fetch<any[]>(`*[_type == "post" && language == "en"] {
    ...,
    author->
  }`);
  return posts.map((post: any) => ({
    params: { slug: post.slug.current },
    props: { post },
  }));
}

const { post } = Astro.props as { post: any };
const lang = 'en';
---

<Layout lang={lang}>
  <SEO
    title={`${post.title} | MJ Fisio Estética y Spa`}
    description={post.title}
    slot="seo"
  />

  <article class="pt-32 pb-20">
    <div class="max-w-3xl mx-auto px-4">
      <header class="mb-8">
        <h1 class="text-4xl md:text-5xl font-serif text-primary mb-4 leading-tight">{post.title}</h1>
        <div class="flex items-center text-muted-foreground gap-4">
          <time datetime={post.publishedAt}>
            {new Date(post.publishedAt).toLocaleDateString('en-US', { day: 'numeric', month: 'long', year: 'numeric' })}
          </time>
        </div>
      </header>

      {post.mainImage && (
        <img
          src={urlFor(post.mainImage).width(1200).url()}
          alt={post.title}
          class="w-full rounded-2xl mb-8 shadow-sm"
        />
      )}

      <div class="prose prose-lg prose-stone max-w-none prose-headings:font-serif prose-headings:text-primary">
        <PortableText value={post.body} />
      </div>

      {post.author && (
        <div class="mt-16 p-8 bg-stone-50 rounded-2xl border border-border flex flex-col md:flex-row gap-6 items-center md:items-start">
          {post.author.image && (
            <img
              src={urlFor(post.author.image).width(200).height(200).url()}
              alt={post.author.name}
              class="w-24 h-24 rounded-full object-cover shadow-sm"
            />
          )}
          <div class="flex-1 text-center md:text-left">
            <p class="text-primary text-xs font-bold tracking-widest uppercase mb-1">About the author</p>
            <h3 class="text-xl font-serif text-stone-900 mb-3">{post.author.name}</h3>
            {post.author.bio && (
              <div class="text-stone-600 text-sm leading-relaxed">
                <PortableText value={post.author.bio} />
              </div>
            )}
          </div>
        </div>
      )}

      <div class="mt-16 pt-8 border-t border-border">
        <a href="/en/blog" class="text-primary font-medium hover:underline">
          ← Back to blog
        </a>
      </div>
    </div>
  </article>
</Layout>

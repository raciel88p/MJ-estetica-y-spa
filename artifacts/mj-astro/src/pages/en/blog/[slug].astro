---
import Layout from "@/layouts/Layout.astro";
import { sanityClient } from "sanity:client";
import { urlFor } from "@/sanity/lib/image";
import { SEO } from "@/components/SEO";
import PortableText from "@/components/blog/PortableText.astro";
import { Navbar } from "@/components/layout/Navbar";
import { Footer } from "@/components/layout/Footer";
import { FloatingWhatsApp } from "@/components/FloatingWhatsApp";

export async function getStaticPaths() {
  const posts = await sanityClient.fetch<any[]>(`*[_type == "post" && language == "en"] {
    ...,
    author->
  }`);
  return posts.map((post: any) => ({
    params: { slug: post.slug.current },
    props: { post },
  }));
}

const { post } = Astro.props as { post: any };
const lang = 'en';
---

<Layout lang={lang}>
  <SEO
    title={`${post.title} | MJ Fisio Estética y Spa`}
    description={post.title}
    slot="seo"
    client:load
  />

  <Navbar lang={lang} client:load />
  <FloatingWhatsApp client:load />

  <article class="bg-white min-h-screen">
    <div class="max-w-4xl mx-auto px-6 pt-44 pb-32">
      {/* ── INFO CABECERA ── */}
      <header class="mb-16">
        <div class="flex items-center gap-3 mb-6">
          <span class="px-3 py-1 bg-primary/10 text-primary text-[10px] font-bold tracking-[0.2em] uppercase rounded-full">Editorial</span>
          <span class="text-stone-200">/</span>
          <time class="text-stone-400 text-[10px] font-bold tracking-[0.2em] uppercase">
            {new Date(post.publishedAt).toLocaleDateString('en-US', { day: 'numeric', month: 'long', year: 'numeric' })}
          </time>
        </div>

        <h1 class="text-4xl md:text-6xl lg:text-7xl font-serif text-stone-900 mb-8 leading-[1.1] tracking-tight">
          {post.title}
        </h1>

        {post.author && (
          <div class="inline-flex items-center gap-4 p-4 bg-stone-50/80 rounded-xl border border-stone-100 shadow-sm max-w-full text-left">
             {post.author.image && (
               <img
                 src={urlFor(post.author.image).width(100).height(100).url()}
                 alt={post.author.name}
                 class="w-12 h-12 rounded-full object-cover shadow-sm ring-2 ring-white shrink-0"
               />
             )}
             <div class="min-w-0 pr-4">
                <p class="text-[9px] font-bold text-primary uppercase tracking-[0.2em]">Written by</p>
                <p class="text-sm font-serif font-bold text-stone-900 truncate">{post.author.name}</p>
                {post.author.role && <p class="text-[10px] text-stone-500 font-medium truncate">{post.author.role}</p>}
             </div>
             {post.author.linkedin && (
               <a href={post.author.linkedin} target="_blank" rel="noopener noreferrer"
                 class="ml-auto w-8 h-8 rounded-full bg-white border border-stone-200 flex items-center justify-center text-stone-400 hover:text-[#0077b5] hover:border-[#0077b5] transition-all shadow-xs shrink-0"
                 title="Connect on LinkedIn">
                 <svg xmlns="http://www.w3.org/2000/svg" width="12" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
               </a>
             )}
          </div>
        )}
      </header>

      {/* ── IMAGEN DESTACADA ── */}
      {post.mainImage && (
        <div class="relative aspect-[16/9] md:aspect-[21/9] rounded-2xl overflow-hidden shadow-2xl mb-20 bg-stone-100">
          <img
            src={urlFor(post.mainImage).width(1600).url()}
            alt={post.title}
            class="w-full h-full object-cover"
          />
        </div>
      )}

      {/* ── CONTENIDO ── */}
      <div class="max-w-2xl mx-auto">
        <div class="prose prose-lg prose-stone max-w-none
          prose-headings:font-serif prose-headings:text-stone-900 prose-headings:font-bold prose-headings:tracking-tight
          prose-p:text-stone-600/90 prose-p:leading-[1.8] prose-p:text-lg prose-p:font-light
          prose-blockquote:border-primary prose-blockquote:bg-stone-50 prose-blockquote:rounded-r-lg prose-blockquote:italic
          prose-img:rounded-xl prose-img:shadow-2xl
          prose-strong:text-stone-900
          prose-a:text-primary prose-a:font-medium hover:prose-a:text-primary/80 transition-colors">
          <PortableText value={post.body} />
        </div>

        <div class="mt-24 pt-12 border-t border-stone-100">
           <div class="flex flex-wrap gap-2 mb-12">
              <span class="text-[10px] font-bold text-stone-400 uppercase tracking-widest mr-2">Topics:</span>
              <span class="px-3 py-1 bg-stone-50 text-stone-500 text-[10px] font-bold uppercase rounded-full border border-stone-100 italic">Wellness</span>
              <span class="px-3 py-1 bg-stone-50 text-stone-500 text-[10px] font-bold uppercase rounded-full border border-stone-100 italic">MJ Care</span>
           </div>
        </div>

      {post.author && (
        <div class="mt-24 p-10 bg-[#f9fafb] rounded-sm border border-stone-100 flex flex-col md:flex-row gap-10 items-center md:items-start relative overflow-hidden group">
          <div class="absolute top-0 right-0 w-32 h-32 bg-primary/5 rounded-full -translate-y-1/2 translate-x-1/2 blur-2xl transition-transform group-hover:scale-150 duration-700"></div>

          <div class="shrink-0 relative">
            <div class="w-32 h-32 rounded-full overflow-hidden shadow-xl ring-8 ring-white transition-transform duration-500 group-hover:scale-105">
              {post.author.image ? (
                <img
                  src={urlFor(post.author.image).width(300).height(300).url()}
                  alt={post.author.name}
                  class="w-full h-full object-cover"
                />
              ) : (
                <div class="w-full h-full bg-stone-200 flex items-center justify-center">
                   <span class="text-stone-400 font-bold text-3xl">{post.author.name.charAt(0)}</span>
                </div>
              )}
            </div>
            <div class="absolute -bottom-2 -right-2 bg-primary text-white p-2 rounded-full shadow-lg">
               <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            </div>
          </div>

          <div class="flex-1 text-center md:text-left z-10">
            <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-4">
              <div>
                <p class="text-primary text-[10px] font-bold tracking-[0.3em] uppercase mb-1">MJ Author</p>
                <h3 class="text-3xl font-serif text-stone-900 leading-tight">{post.author.name}</h3>
                {post.author.role && <p class="text-stone-500 text-xs font-medium uppercase tracking-widest mt-1">{post.author.role}</p>}
              </div>

              {post.author.linkedin && (
                <a href={post.author.linkedin} target="_blank" rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 px-4 py-2 bg-white border border-stone-200 rounded-full text-xs font-bold text-stone-600 hover:text-[#0077b5] hover:border-[#0077b5] transition-all shadow-sm self-center md:self-start">
                   <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
                   Connect
                </a>
              )}
            </div>

            {post.author.bio ? (
              <div class="text-stone-500 text-sm leading-relaxed font-light prose prose-sm prose-stone max-w-none
                prose-p:mt-0 prose-p:mb-0 italic italic-stone-400">
                <PortableText value={post.author.bio} />
              </div>
            ) : (
              <p class="text-stone-400 text-sm italic">Specialist committed to excellence in health and aesthetic wellness at MJ Fisio Estética y Spa.</p>
            )}
          </div>
        </div>
      )}

      <div class="mt-16 pt-8 border-t border-border">
        <a href="/en/blog" class="text-primary font-medium hover:underline">
          ← Back to blog
        </a>
      </div>
    </div>
  </article>

  <Footer lang={lang} client:load />
</Layout>

---
import Layout from "@/layouts/Layout.astro";
import { sanityClient } from "sanity:client";
import { urlFor } from "@/sanity/lib/image";
import { SEO } from "@/components/SEO";
import PortableText from "@/components/blog/PortableText.astro";
import { Navbar } from "@/components/layout/Navbar";
import { Footer } from "@/components/layout/Footer";
import { FloatingWhatsApp } from "@/components/FloatingWhatsApp";

export async function getStaticPaths() {
  const posts = await sanityClient.fetch<any[]>(`*[_type == "post" && language == "en"] {
    ...,
    author->
  }`);
  return posts.map((post: any) => ({
    params: { slug: post.slug.current },
    props: { post },
  }));
}

const { post } = Astro.props as { post: any };
const lang = 'en';
---

<Layout lang={lang}>
  <SEO
    title={`${post.title} | MJ Fisio Estética y Spa`}
    description={post.title}
    slot="seo"
    client:load
  />

  <Navbar lang={lang} client:load />
  <FloatingWhatsApp client:load />

  <article class="bg-white">
    {/* ── HEADER EDITORIAL ──────────────────────────── */}
    <header class="relative pt-44 pb-20 bg-stone-50 overflow-hidden">
      <div class="container relative z-10 mx-auto px-6 text-center">
        <div class="max-w-4xl mx-auto">
          <div class="flex items-center justify-center gap-4 mb-8">
             <span class="w-12 h-px bg-primary/30"></span>
             <time class="text-primary text-[10px] font-bold tracking-[0.3em] uppercase">
                {new Date(post.publishedAt).toLocaleDateString('en-US', { day: 'numeric', month: 'long', year: 'numeric' })}
             </time>
             <span class="w-12 h-px bg-primary/30"></span>
          </div>
          <h1 class="text-4xl md:text-6xl lg:text-7xl font-serif text-stone-900 mb-10 leading-tight">
            {post.title}
          </h1>
          <div class="flex items-center justify-center gap-3">
             {post.author?.image && (
               <img
                 src={urlFor(post.author.image).width(80).height(80).url()}
                 alt={post.author.name}
                 class="w-10 h-10 rounded-full object-cover shadow-md border-2 border-white"
               />
             )}
             <span class="text-xs font-bold text-stone-400 uppercase tracking-widest">Written by {post.author?.name}</span>
          </div>
        </div>
      </div>
      <div class="absolute inset-0 z-0 opacity-40">
         <div class="absolute inset-0 bg-[radial-gradient(#1378A2_1px,transparent_1px)] [background-size:20px_20px] opacity-10"></div>
      </div>
    </header>

    <div class="max-w-4xl mx-auto px-6 -mt-10 relative z-20 pb-32">
      {post.mainImage && (
        <div class="aspect-[16/9] md:aspect-[21/9] rounded-sm overflow-hidden shadow-2xl mb-20 border-8 border-white">
          <img
            src={urlFor(post.mainImage).width(1600).url()}
            alt={post.title}
            class="w-full h-full object-cover"
          />
        </div>
      )}

      <div class="max-w-3xl mx-auto">
        <div class="prose prose-lg prose-stone max-w-none
          prose-headings:font-serif prose-headings:text-stone-900 prose-headings:tracking-tight
          prose-p:text-stone-600 prose-p:leading-relaxed prose-p:font-light
          prose-blockquote:border-primary prose-blockquote:bg-stone-50 prose-blockquote:py-2 prose-blockquote:px-8 prose-blockquote:italic
          prose-strong:text-stone-900 prose-strong:font-bold
          prose-img:rounded-sm prose-img:shadow-lg
          prose-a:text-primary prose-a:no-underline hover:prose-a:underline transition-all">
          <PortableText value={post.body} />
        </div>

        <div class="mt-24 pt-12 border-t border-stone-100">
           <div class="flex flex-wrap gap-2 mb-12">
              <span class="text-[10px] font-bold text-stone-400 uppercase tracking-widest mr-2">Topics:</span>
              <span class="px-3 py-1 bg-stone-50 text-stone-500 text-[10px] font-bold uppercase rounded-full border border-stone-100 italic">Wellness</span>
              <span class="px-3 py-1 bg-stone-50 text-stone-500 text-[10px] font-bold uppercase rounded-full border border-stone-100 italic">MJ Care</span>
           </div>
        </div>

      {post.author && (
        <div class="mt-16 p-8 bg-stone-50 rounded-2xl border border-border flex flex-col md:flex-row gap-8 items-center md:items-start">
          <div class="shrink-0 relative">
            <div class="w-24 h-24 rounded-full overflow-hidden shadow-md ring-4 ring-white">
              {post.author.image ? (
                <img
                  src={urlFor(post.author.image).width(200).height(200).url()}
                  alt={post.author.name}
                  class="w-full h-full object-cover"
                />
              ) : (
                <div class="w-full h-full bg-stone-200 flex items-center justify-center">
                   <span class="text-stone-400 font-bold text-2xl">{post.author.name.charAt(0)}</span>
                </div>
              )}
            </div>
            <div class="absolute -bottom-2 -right-2 bg-primary text-white p-1.5 rounded-full shadow-sm">
               <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            </div>
          </div>
          <div class="flex-1 text-center md:text-left">
            <p class="text-primary text-[10px] font-bold tracking-[0.2em] uppercase mb-1">MJ Experts</p>
            <h3 class="text-2xl font-serif text-stone-900 mb-2">{post.author.name}</h3>
            {post.author.role && <p class="text-stone-500 text-xs font-medium uppercase tracking-wider mb-3">{post.author.role}</p>}
            {post.author.bio && (
              <div class="text-stone-600 text-sm leading-relaxed font-light prose prose-sm prose-stone max-w-none">
                <PortableText value={post.author.bio} />
              </div>
            )}
            <div class="mt-4 flex justify-center md:justify-start gap-4">
               {post.author.linkedin && (
                 <a href={post.author.linkedin} target="_blank" rel="noopener noreferrer" class="text-stone-400 hover:text-primary transition-colors">
                   <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/></svg>
                 </a>
               )}
            </div>
          </div>
        </div>
      )}

      <div class="mt-16 pt-8 border-t border-border">
        <a href="/en/blog" class="text-primary font-medium hover:underline">
          ← Back to blog
        </a>
      </div>
    </div>
  </article>

  <Footer lang={lang} client:load />
</Layout>

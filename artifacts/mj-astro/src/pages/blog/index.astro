---
import Layout from "@/layouts/Layout.astro";
import { sanityClient } from "sanity:client";
import { urlFor } from "@/sanity/lib/image";
import { SEO } from "@/components/SEO";
import { Navbar } from "@/components/layout/Navbar";
import { Footer } from "@/components/layout/Footer";
import { FloatingWhatsApp } from "@/components/FloatingWhatsApp";

const posts = await sanityClient.fetch<any[]>(`*[_type == "post" && language == "es"] | order(publishedAt desc) {
  ...,
  author->
}`);
const authors = await sanityClient.fetch<any[]>(`*[_type == "author"] | order(name asc)`);
const lang = 'es';
---

<Layout lang={lang}>
  <SEO
    title="Blog & Publicaciones | MJ Fisio Estética y Spa"
    description="Consejos de salud, medicina estética, odontología y bienestar en Turrialba y Siquirres."
    slot="seo"
    client:load
  />

  <Navbar lang={lang} client:load />
  <FloatingWhatsApp client:load />

  <main class="bg-white">
    {/* ── HERO BLOG ────────────────────────────────── */}
    <section class="relative pt-44 pb-24 bg-[#050c14] overflow-hidden">
      <div class="absolute inset-0 z-0">
        <div class="absolute inset-0 bg-gradient-to-b from-primary/10 to-transparent opacity-30"></div>
        <div class="absolute bottom-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-primary/20 to-transparent"></div>
      </div>

      <div class="container relative z-10 mx-auto px-6">
        <div class="max-w-3xl">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-primary/10 border border-primary/20 backdrop-blur-sm mb-6">
            <span class="w-2 h-2 rounded-full bg-primary animate-pulse"></span>
            <span class="text-primary text-[10px] font-bold tracking-[0.2em] uppercase">Magazine & Wellness</span>
          </div>
          <h1 class="text-5xl md:text-7xl font-serif font-bold text-white leading-tight mb-6">
            Diario de <br />
            <span class="italic font-light text-primary">Bienestar</span>
          </h1>
          <p class="text-lg md:text-xl text-white/60 font-light leading-relaxed max-w-xl">
            Explora consejos expertos, tendencias en medicina estética, odontología integral y rituales de cuidado personal diseñados para tu mejor versión.
          </p>
        </div>
      </div>
    </section>

    <div class="container mx-auto px-6 -mt-12 relative z-20 pb-32">
      {/* ── CATEGORÍAS & FILTRO POR EXPERTO ─────────────── */}
      <div class="bg-white p-6 rounded-2xl shadow-xl border border-stone-200/80 mb-16" id="filtro-categoria">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-4 pb-4 border-b border-stone-100">
          <div>
            <h3 class="font-serif font-bold text-stone-900 text-lg">Filtrar Publicaciones por Categoria de Experto</h3>
            <p class="text-stone-500 text-xs">Selecciona un tema o especialista para explorar artículos específicos</p>
          </div>
          <span class="text-xs font-bold text-primary bg-primary/10 px-3 py-1 rounded-full w-fit">
            {posts.length} {posts.length === 1 ? 'Artículo' : 'Artículos'}
          </span>
        </div>

        <div class="flex flex-wrap gap-2.5" id="filter-buttons">
          <button
            data-filter="all"
            class="filter-btn px-4 py-2 rounded-full text-xs font-bold uppercase tracking-wider transition-all bg-primary text-white shadow-sm"
          >
            Todos
          </button>
          {authors.map((author: any) => (
            <button
              data-filter={author.name}
              class="filter-btn px-4 py-2 rounded-full text-xs font-bold uppercase tracking-wider transition-all bg-stone-100 text-stone-700 hover:bg-stone-200 border border-stone-200/80"
            >
              {author.name} {author.role ? `• ${author.role}` : ''}
            </button>
          ))}
        </div>
      </div>

      {/* ── POST DESTACADO ────────────────────────────── */}
      {posts.length > 0 && (
        <article class="post-card group bg-white rounded-sm shadow-2xl overflow-hidden mb-20 border border-stone-100" data-author={posts[0].author?.name || ''}>
          <div class="flex flex-col lg:flex-row">
            <div class="lg:w-3/5 overflow-hidden">
              <a href={`/blog/${posts[0].slug.current}`} class="block h-full">
                <img
                  src={urlFor(posts[0].mainImage).width(1200).height(800).url()}
                  alt={posts[0].title}
                  class="w-full h-full object-cover transition-transform duration-1000 group-hover:scale-105"
                />
              </a>
            </div>
            <div class="lg:w-2/5 p-8 md:p-12 lg:p-16 flex flex-col justify-center">
               <div class="flex items-center gap-3 mb-6 flex-wrap">
                  <span class="px-3 py-1 bg-stone-100 text-stone-500 text-[10px] font-bold tracking-widest uppercase rounded-full">Destacado</span>
                  {posts[0].author?.role && (
                    <span class="px-3 py-1 bg-primary/10 text-primary text-[10px] font-bold tracking-widest uppercase rounded-full border border-primary/20">
                      {posts[0].author.role}
                    </span>
                  )}
                  <span class="text-stone-300">•</span>
                  <time class="text-stone-400 text-[10px] font-medium uppercase tracking-widest">
                    {new Date(posts[0].publishedAt).toLocaleDateString('es-ES', { month: 'long', year: 'numeric' })}
                  </time>
               </div>
               <h2 class="text-3xl md:text-4xl font-serif text-stone-900 mb-6 leading-tight group-hover:text-primary transition-colors">
                 <a href={`/blog/${posts[0].slug.current}`}>{posts[0].title}</a>
               </h2>
               <p class="text-stone-500 font-light leading-relaxed mb-10 line-clamp-3">
                 {posts[0].excerpt || "Descubre los secretos mejor guardados para el cuidado de tu piel y bienestar integral en nuestra última publicación editorial."}
               </p>
               <a href={`/blog/${posts[0].slug.current}`} class="inline-flex items-center gap-3 text-xs font-bold tracking-[0.2em] uppercase text-stone-900 group/btn">
                  Continuar leyendo
                  <span class="w-8 h-px bg-stone-300 group-hover/btn:w-12 group-hover/btn:bg-primary transition-all"></span>
               </a>
            </div>
          </div>
        </article>
      )}

      {/* ── GRID DE ARTÍCULOS ─────────────────────────── */}
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-20" id="posts-grid">
        {posts.slice(1).map((post: any) => (
          <article class="post-card group flex flex-col" data-author={post.author?.name || ''}>
            <div class="relative aspect-[4/5] overflow-hidden bg-stone-100 mb-8 rounded-sm shadow-sm transition-all duration-500 group-hover:shadow-xl group-hover:-translate-y-1">
              {post.mainImage && (
                <a href={`/blog/${post.slug.current}`} class="block h-full">
                  <img
                    src={urlFor(post.mainImage).width(800).height(1000).url()}
                    alt={post.title}
                    class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
                  />
                  <div class="absolute inset-0 bg-black/5 group-hover:bg-transparent transition-colors"></div>
                </a>
              )}
            </div>

            <div class="flex flex-col flex-1">
              <div class="flex items-center gap-2 mb-3 flex-wrap">
                <time class="text-primary text-[10px] font-bold tracking-[0.2em] uppercase block">
                  {new Date(post.publishedAt).toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric' })}
                </time>
                {post.author?.role && (
                  <span class="text-[10px] font-bold text-stone-500 bg-stone-100 px-2 py-0.5 rounded-full border border-stone-200">
                    {post.author.role}
                  </span>
                )}
              </div>

              <h3 class="text-2xl font-serif text-stone-900 mb-4 leading-tight group-hover:text-primary transition-colors">
                <a href={`/blog/${post.slug.current}`}>
                  {post.title}
                </a>
              </h3>
              <div class="mt-auto pt-6 flex items-center gap-3 border-t border-stone-100">
                {post.author?.image && (
                  <img
                    src={urlFor(post.author.image).width(80).url()}
                    alt={post.author.name}
                    class="w-8 h-8 rounded-full object-cover object-top grayscale group-hover:grayscale-0 transition-all shadow-sm"
                  />
                )}
                <div>
                  <span class="text-[10px] text-stone-900 font-bold uppercase tracking-widest block">
                    {post.author?.name}
                  </span>
                  {post.author?.role && (
                    <span class="text-[9px] text-primary font-medium block">
                      {post.author.role}
                    </span>
                  )}
                </div>
              </div>
            </div>
          </article>
        ))}
      </div>

      {posts.length === 0 && (
        <div class="text-center py-20 bg-stone-50 rounded-3xl border-2 border-dashed border-stone-200">
           <p class="text-stone-400 font-medium">Próximamente compartiremos contenido muy especial contigo.</p>
        </div>
      )}

      {/* ── NUESTROS EXPERTOS MOSTRANDO CATEGORÍA Y ESPECIALIDAD ── */}
      {authors.length > 0 && (
        <div class="mt-32">
          <div class="text-center mb-12">
            <span class="text-xs font-bold text-primary uppercase tracking-widest block mb-2">
              Equipo Médico & Especialistas
            </span>
            <h2 class="text-3xl sm:text-4xl font-serif font-bold text-stone-900 mb-4">Nuestros Expertos</h2>
            <p class="text-stone-600 text-sm max-w-xl mx-auto">
              Conoce a los profesionales de la salud y el bienestar detrás de cada una de nuestras áreas de especialidad.
            </p>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
            {authors.map((author: any) => (
              <div class="text-center group bg-stone-50 p-6 rounded-2xl border border-stone-200/80 shadow-sm hover:shadow-md transition-shadow">
                <div class="relative w-32 h-32 mx-auto mb-4 overflow-hidden rounded-full shadow-md transition-transform group-hover:scale-105 border-2 border-white">
                  {author.image ? (
                    <img
                      src={urlFor(author.image).width(300).url()}
                      alt={author.name}
                      class="w-full h-full object-cover object-top"
                    />
                  ) : (
                    <div class="w-full h-full bg-stone-200 flex items-center justify-center">
                       <span class="text-stone-400 font-bold text-2xl">{author.name.charAt(0)}</span>
                    </div>
                  )}
                </div>
                <h3 class="font-serif text-lg font-bold text-stone-900 mb-1">{author.name}</h3>
                {author.role ? (
                  <span class="inline-block text-xs font-semibold text-primary bg-primary/10 px-3 py-1 rounded-full border border-primary/20 mb-3">
                    {author.role}
                  </span>
                ) : (
                  <span class="inline-block text-xs text-stone-500 mb-3">Especialista Wellness</span>
                )}
                {author.shortBio && (
                  <p class="text-stone-500 text-xs line-clamp-2 leading-relaxed">{author.shortBio}</p>
                )}
              </div>
            ))}
          </div>
        </div>
      )}
    </div>
  </main>

  <Footer lang={lang} client:load />

  <script>
    document.addEventListener("DOMContentLoaded", () => {
      const buttons = document.querySelectorAll(".filter-btn");
      const cards = document.querySelectorAll(".post-card");

      buttons.forEach((btn) => {
        btn.addEventListener("click", () => {
          const filter = btn.getAttribute("data-filter");

          buttons.forEach((b) => {
            b.classList.remove("bg-primary", "text-white", "shadow-sm");
            b.classList.add("bg-stone-100", "text-stone-700", "border", "border-stone-200/80");
          });
          btn.classList.remove("bg-stone-100", "text-stone-700", "border", "border-stone-200/80");
          btn.classList.add("bg-primary", "text-white", "shadow-sm");

          cards.forEach((card) => {
            const author = card.getAttribute("data-author");
            if (filter === "all" || author === filter) {
              (card as HTMLElement).style.display = "";
            } else {
              (card as HTMLElement).style.display = "none";
            }
          });
        });
      });
    });
  </script>
</Layout>

---
import Layout from "@/layouts/Layout.astro";
import { sanityClient } from "sanity:client";
import { urlFor } from "@/sanity/lib/image";
import { SEO } from "@/components/SEO";
import { Navbar } from "@/components/layout/Navbar";
import { Footer } from "@/components/layout/Footer";
import { FloatingWhatsApp } from "@/components/FloatingWhatsApp";

const posts = await sanityClient.fetch<any[]>(`*[_type == "post" && language == "es"] | order(publishedAt desc) {
  ...,
  author->
}`);
const authors = await sanityClient.fetch<any[]>(`*[_type == "author"] | order(name asc)`);
const lang = 'es';
---

<Layout lang={lang}>
  <SEO
    title="Blog | MJ Fisio Estética y Spa"
    description="Consejos sobre salud, belleza y bienestar en Turrialba."
    slot="seo"
    client:load
  />

  <Navbar lang={lang} client:load />
  <FloatingWhatsApp client:load />

  <main class="pt-32 pb-20">
    <div class="max-w-7xl mx-auto px-4">
      <div class="text-center mb-16">
        <h1 class="text-4xl md:text-5xl font-serif text-primary mb-4">Nuestro Blog</h1>
        <p class="text-xl text-muted-foreground">Consejos y novedades sobre bienestar y estética.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {posts.map((post: any) => (
          <article class="bg-white rounded-2xl shadow-sm border border-border overflow-hidden hover:shadow-md transition-shadow">
            {post.mainImage && (
              <a href={`/blog/${post.slug.current}`}>
                <img
                  src={urlFor(post.mainImage).width(600).height(400).url()}
                  alt={post.title}
                  class="w-full h-48 object-cover"
                />
              </a>
            )}
            <div class="p-6">
              <h2 class="text-xl font-serif mb-2">
                <a href={`/blog/${post.slug.current}`} class="hover:text-primary transition-colors">
                  {post.title}
                </a>
              </h2>
              <div class="flex items-center gap-2 mb-4">
                {post.author?.image && (
                  <img
                    src={urlFor(post.author.image).width(40).height(40).url()}
                    alt={post.author.name}
                    class="w-6 h-6 rounded-full object-cover"
                  />
                )}
                <p class="text-xs text-muted-foreground">
                  <span class="font-medium text-stone-700">{post.author?.name}</span> • {new Date(post.publishedAt).toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric' })}
                </p>
              </div>
              <a href={`/blog/${post.slug.current}`} class="text-primary font-medium hover:underline">
                Leer más →
              </a>
            </div>
          </article>
        ))}
      </div>

      {posts.length === 0 && (
        <div class="text-center py-20 bg-stone-50 rounded-3xl border-2 border-dashed border-stone-200">
           <p class="text-stone-400 font-medium">Próximamente compartiremos contenido muy especial contigo.</p>
        </div>
      )}

      {authors.length > 0 && (
        <div class="mt-32">
          <div class="text-center mb-12">
            <h2 class="text-3xl font-serif text-primary mb-4">Nuestros Expertos</h2>
            <p class="text-muted-foreground text-lg">Conoce a las mentes detrás de nuestro contenido de bienestar.</p>
          </div>
          <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
            {authors.map((author: any) => (
              <div class="text-center group">
                <div class="relative w-32 h-32 mx-auto mb-4 overflow-hidden rounded-full shadow-md transition-transform group-hover:scale-105">
                  {author.image ? (
                    <img
                      src={urlFor(author.image).width(200).height(200).url()}
                      alt={author.name}
                      class="w-full h-full object-cover"
                    />
                  ) : (
                    <div class="w-full h-full bg-stone-200 flex items-center justify-center">
                       <span class="text-stone-400 font-bold text-2xl">{author.name.charAt(0)}</span>
                    </div>
                  )}
                </div>
                <h3 class="font-serif text-lg font-medium text-stone-900">{author.name}</h3>
              </div>
            ))}
          </div>
        </div>
      )}
    </div>
  </main>

  <Footer lang={lang} client:load />
</Layout>

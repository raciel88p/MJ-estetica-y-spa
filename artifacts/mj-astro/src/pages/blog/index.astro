---
import Layout from "../../layouts/Layout.astro";
import { Navbar } from "../../components/layout/Navbar";
import { Footer } from "../../components/layout/Footer";
import { getCollection } from "astro:content";

const allPosts = await getCollection("blog");
const authors = await getCollection("autores");

// Sort by date
const posts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

function getSlug(post: any) {
    return post.id;
}
---

<Layout title="Blog | MJ Estética Wellness Center" description="Noticias, consejos y artículos sobre estética, masajes y bienestar.">
  <Navbar client:load />

  <main class="min-h-screen pt-24 pb-16 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h1 class="text-4xl font-bold text-gray-900 mb-4">Nuestro Blog</h1>
        <p class="text-xl text-gray-600 max-w-2xl mx-auto">
          Consejos, novedades y todo lo que necesitas saber sobre bienestar y estética.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {posts.map((post) => {
          const title = post.data.title;
          const description = post.data.description || "";
          const date = post.data.pubDate;
          const tags = post.data.tags || [];
          const slug = getSlug(post);

          let author = null;
          let authorName = "";
          let authorPhotoUrl = "/images/mj-logo.png";

          if (post.data.authorId) {
              author = authors.find(a => a.id === post.data.authorId);
              if (author) {
                  authorName = author.data.name;
                  authorPhotoUrl = author.data.photoUrl || authorPhotoUrl;
              }
          }

          return (
            <article class="bg-white rounded-xl shadow-sm hover:shadow-md transition-shadow duration-300 overflow-hidden border border-gray-100 flex flex-col h-full">
              <div class="p-6 flex flex-col flex-grow">
                <div class="flex gap-2 mb-3">
                  {tags.map((tag) => (
                    <span class="text-xs font-medium px-2.5 py-0.5 rounded-full bg-primary/10 text-primary">
                      {tag}
                    </span>
                  ))}
                </div>
                <a href={`/blog/${slug}`}>
                  <h2 class="text-2xl font-semibold text-gray-900 mb-2 hover:text-primary transition-colors">
                    {title}
                  </h2>
                </a>

                {description && (
                  <p class="text-gray-600 line-clamp-3 mb-4 flex-grow">
                    {description}
                  </p>
                )}

                <div class="mt-auto pt-4 border-t border-gray-100 flex items-center justify-between">
                  {author ? (
                     <div class="flex items-center gap-2">
                       <img src={authorPhotoUrl} alt={authorName} class="w-8 h-8 rounded-full object-cover border border-gray-200" />
                       <span class="text-sm font-medium text-gray-900">{authorName}</span>
                     </div>
                  ) : (
                     <span />
                  )}
                  {date && (
                    <time class="text-xs text-gray-500" datetime={date.toISOString()}>
                      {date.toLocaleDateString("es-CR", { year: "numeric", month: "short", day: "numeric" })}
                    </time>
                  )}
                </div>
              </div>
            </article>
          );
        })}
        {posts.length === 0 && (
          <div class="col-span-full text-center py-12">
            <p class="text-gray-500 text-lg">Próximamente publicaremos nuevos artículos. ¡Mantente atento!</p>
          </div>
        )}
      </div>
    </div>
  </main>

  <Footer client:load />
</Layout>

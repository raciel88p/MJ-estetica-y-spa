---
import { getCollection } from "astro:content";
import { getPlainText, getMultiSelect } from "../../lib/notion-helpers";
import Layout from "../../layouts/Layout.astro";
import { Navbar } from "../../components/layout/Navbar";
import { Footer } from "../../components/layout/Footer";
import { marked } from "marked";
// Using the same WhatsApp link structure from the SPA
const WHATSAPP_URL = "https://api.whatsapp.com/message/EEYLUNVMY2UDJ1?autoload=1&app_absent=0";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  const authors = await getCollection("autores");

  return posts.map((post) => {
    let slug = post.id;
    const slugRaw = getPlainText(post.data.properties.Slug);
    if (slugRaw) {
        slug = slugRaw.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)+/g, '');
    }

    let postAuthor = null;
    const autorProp = post.data.properties.Autor;
    if (autorProp && autorProp.type === 'relation' && autorProp.relation.length > 0) {
        const relatedId = autorProp.relation[0].id;
        postAuthor = authors.find(a => a.id === relatedId);
    }

    return {
      params: { slug },
      props: { post, author: postAuthor },
    }
  });
}

const { post, author } = Astro.props;

const title = getPlainText(post.data.properties.Name) || post.id;
const description = getPlainText(post.data.properties.Description) || "";
const date = post.data.properties.Date?.date?.start;
const tags = getMultiSelect(post.data.properties.Tags).map(t => t.name);

const htmlContent = marked.parse(post.data.markdown || "");

let authorName = "Autor Anónimo";
let authorSlug = "";
let authorPhotoUrl = "/images/mj-logo.png";
let authorRole = "";

if (author) {
    authorName = getPlainText(author.data.properties.Name) || authorName;
    authorRole = author.data.properties.Role ? getPlainText(author.data.properties.Role) || "" : "";
    const rawSlug = getPlainText(author.data.properties.Slug);
    authorSlug = rawSlug ? rawSlug.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)+/g, '') : author.id;
    if (author.data.properties.Foto && author.data.properties.Foto.files && author.data.properties.Foto.files.length > 0) {
        const file = author.data.properties.Foto.files[0];
        authorPhotoUrl = file.file ? file.file.url : (file.external ? file.external.url : authorPhotoUrl);
    }
}
---

<Layout title={`${title} | MJ Estética Wellness Center`} description={description}>
  <Navbar client:load />

  <main class="min-h-screen pt-24 pb-16 bg-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">

      {/* Blog Post Header (Centered) */}
      <header class="mb-10 text-center max-w-3xl mx-auto">
        {tags.length > 0 && (
          <div class="flex justify-center gap-2 mb-4">
            {tags.map((tag) => (
              <span class="text-xs font-medium px-3 py-1 rounded-full bg-primary/10 text-primary">
                {tag}
              </span>
            ))}
          </div>
        )}
        <h1 class="text-4xl sm:text-5xl font-bold text-gray-900 mb-6 leading-tight">
          {title}
        </h1>

        <div class="flex items-center justify-center gap-4 mt-6">
           {author && (
             <a href={`/autores/${authorSlug}`} class="flex items-center gap-3 hover:opacity-80 transition-opacity">
               <img src={authorPhotoUrl} alt={authorName} class="w-12 h-12 rounded-full object-cover border-2 border-primary/20" />
               <div class="text-left">
                 <p class="font-semibold text-gray-900 text-sm">{authorName}</p>
                 {authorRole && <p class="text-xs text-primary">{authorRole}</p>}
               </div>
             </a>
           )}

           {date && (
             <div class="flex items-center text-gray-500 pl-4 border-l border-gray-200">
               <time datetime={date}>
                 {new Date(date).toLocaleDateString("es-CR", { year: "numeric", month: "long", day: "numeric" })}
               </time>
             </div>
           )}
        </div>
      </header>

      {/* Main Content Layout (Grid) */}
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">

        {/* Left Column: Article Content */}
        <article class="lg:col-span-8">
          <div class="prose prose-lg prose-primary max-w-none prose-headings:font-semibold prose-a:text-primary hover:prose-a:text-primary/80" set:html={htmlContent} />

          <div class="mt-16 pt-8 border-t border-gray-100 flex flex-col sm:flex-row justify-between items-center gap-4">
            {author && (
                <div class="bg-gray-50 rounded-xl p-6 flex flex-col sm:flex-row items-center gap-4 w-full sm:w-auto flex-grow border border-gray-100">
                   <img src={authorPhotoUrl} alt={authorName} class="w-16 h-16 rounded-full object-cover shadow-sm" />
                   <div class="text-center sm:text-left">
                      <p class="text-sm text-gray-500 mb-1">Escrito por</p>
                      <a href={`/autores/${authorSlug}`} class="font-bold text-lg text-gray-900 hover:text-primary transition-colors">{authorName}</a>
                      {authorRole && <p class="text-sm text-primary font-medium">{authorRole}</p>}
                   </div>
                </div>
            )}

            <a href="/blog" class="inline-flex items-center px-4 py-2 bg-white border border-gray-200 rounded-lg text-gray-700 hover:bg-gray-50 hover:text-primary transition-colors font-medium shrink-0">
              <svg class="w-5 h-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
              </svg>
              Volver al blog
            </a>
          </div>
        </article>

        {/* Right Column: CTA Sidebar */}
        <aside class="lg:col-span-4 lg:sticky lg:top-24 mt-8 lg:mt-0">
           <div class="bg-gradient-to-br from-[#071e2e] to-primary/90 rounded-2xl p-8 text-center text-white shadow-xl relative overflow-hidden">
              <!-- Decorative background element -->
              <div class="absolute -top-12 -right-12 w-32 h-32 bg-white/10 rounded-full blur-2xl"></div>
              <div class="absolute -bottom-12 -left-12 w-32 h-32 bg-primary/40 rounded-full blur-2xl"></div>

              <div class="relative z-10">
                  <svg class="w-12 h-12 mx-auto mb-4 text-white/90" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                     <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                  </svg>

                  <h3 class="text-2xl font-serif font-bold mb-3">¿Te interesa este tratamiento?</h3>
                  <p class="text-white/80 mb-8 text-sm leading-relaxed">
                    Agenda una cita de valoración gratuita con nuestros especialistas y descubre cómo podemos ayudarte a alcanzar tus objetivos.
                  </p>

                  <a
                    href={WHATSAPP_URL}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center justify-center w-full px-6 py-3.5 bg-white text-primary font-bold rounded-xl shadow-lg hover:bg-gray-50 hover:-translate-y-0.5 transition-all duration-300"
                  >
                    <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.327.101.144.447.706.945 1.152.645.578 1.203.766 1.348.823.144.058.231.043.318-.058l.362-.428c.101-.144.202-.116.332-.072.13.043.824.391.968.463.144.072.231.116.275.188.043.072.043.405-.101.81z"/>
                    </svg>
                    Agendar por WhatsApp
                  </a>
              </div>
           </div>
        </aside>

      </div>
    </div>
  </main>

  <Footer client:load />
</Layout>

---
import { getCollection } from "astro:content";
import { getPlainText, getMultiSelect } from "notro-loader";
import Layout from "../../layouts/Layout.astro";
import { Navbar } from "../../components/layout/Navbar";
import { Footer } from "../../components/layout/Footer";

export async function getStaticPaths() {
  const allAuthors = await getCollection("autores");

  return allAuthors.map((author) => {
    let slug = author.id;
    const slugRaw = getPlainText(author.data.properties.Slug);
    if (slugRaw) {
        slug = slugRaw.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)+/g, '');
    }

    return {
      params: { slug },
      props: { author },
    }
  });
}

const { author } = Astro.props;

const name = getPlainText(author.data.properties.Name) || "Autor Anónimo";
const role = getPlainText(author.data.properties.Role) || "";
const bio = getPlainText(author.data.properties.Bio) || "";

let photoUrl = "/images/mj-logo.png";
if (author.data.properties.Foto && author.data.properties.Foto.files && author.data.properties.Foto.files.length > 0) {
    const file = author.data.properties.Foto.files[0];
    photoUrl = file.file ? file.file.url : (file.external ? file.external.url : photoUrl);
}

// Fetch posts by this author
const allPosts = await getCollection("blog");
const authorPosts = allPosts.filter(post => {
    // Determine if this post has a relation to this author
    const postAutor = post.data.properties.Autor;
    if (!postAutor) return false;

    // It can be a Relation array
    if (postAutor.type === 'relation') {
        return postAutor.relation.some((rel: any) => rel.id === author.id);
    }
    // Or if it was mapped via people property temporarily
    if (postAutor.type === 'people') {
        // Fallback for names if no relation is established
        return false;
    }
    return false;
}).sort((a, b) => {
  const dateA = a.data.properties.Date?.date?.start ? new Date(a.data.properties.Date.date.start).getTime() : 0;
  const dateB = b.data.properties.Date?.date?.start ? new Date(b.data.properties.Date.date.start).getTime() : 0;
  return dateB - dateA;
});

function getPostSlug(post: any) {
    let slug = post.id;
    const slugRaw = getPlainText(post.data.properties.Slug);
    if (slugRaw) {
        slug = slugRaw.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)+/g, '');
    }
    return slug;
}
---

<Layout title={`${name} - Autores | MJ Estética Wellness Center`} description={bio}>
  <Navbar client:load />

  <main class="min-h-screen pt-24 pb-16 bg-gray-50">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">

      {/* Author Profile Header */}
      <div class="bg-white rounded-2xl shadow-sm p-8 md:p-12 mb-12 flex flex-col md:flex-row items-center md:items-start gap-8 border border-gray-100">
        <img
          src={photoUrl}
          alt={name}
          class="w-40 h-40 rounded-full object-cover border-4 border-primary/10 flex-shrink-0"
          loading="eager"
          decoding="sync"
        />
        <div class="text-center md:text-left flex-grow">
          <h1 class="text-4xl font-bold text-gray-900 mb-2">{name}</h1>
          {role && (
            <p class="text-xl text-primary font-medium mb-4">{role}</p>
          )}
          {bio && (
            <p class="text-gray-600 text-lg leading-relaxed">{bio}</p>
          )}
          <div class="mt-6 flex justify-center md:justify-start">
             <a href="/autores" class="text-sm font-medium text-gray-500 hover:text-primary transition-colors flex items-center">
                <svg class="w-4 h-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" /></svg>
                Ver todos los autores
             </a>
          </div>
        </div>
      </div>

      {/* Author's Posts */}
      <h2 class="text-2xl font-bold text-gray-900 mb-8 border-b pb-4">Artículos publicados por {name}</h2>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {authorPosts.map((post) => {
          const postTitle = getPlainText(post.data.properties.Name) || post.id;
          const postDescription = getPlainText(post.data.properties.Description) || "";
          const postDate = post.data.properties.Date?.date?.start;
          const tags = getMultiSelect(post.data.properties.Tags).map(t => t.name);
          const postSlug = getPostSlug(post);

          return (
            <article class="bg-white rounded-xl shadow-sm hover:shadow-md transition-shadow duration-300 p-6 border border-gray-100 flex flex-col">
              <div class="flex gap-2 mb-3">
                {tags.map((tag) => (
                  <span class="text-xs font-medium px-2.5 py-0.5 rounded-full bg-primary/10 text-primary">
                    {tag}
                  </span>
                ))}
              </div>
              <a href={`/blog/${postSlug}`}>
                <h3 class="text-xl font-semibold text-gray-900 mb-2 hover:text-primary transition-colors">
                  {postTitle}
                </h3>
              </a>
              {postDate && (
                <time class="text-sm text-gray-500 mb-3 block" datetime={postDate}>
                  {new Date(postDate).toLocaleDateString("es-CR", { year: "numeric", month: "long", day: "numeric" })}
                </time>
              )}
              {postDescription && (
                <p class="text-gray-600 line-clamp-2 mb-4 text-sm flex-grow">
                  {postDescription}
                </p>
              )}
              <div class="mt-auto pt-4">
                <a href={`/blog/${postSlug}`} class="text-primary text-sm font-medium hover:text-primary/80 transition-colors inline-flex items-center">
                  Leer más
                  <svg class="w-4 h-4 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                  </svg>
                </a>
              </div>
            </article>
          );
        })}
        {authorPosts.length === 0 && (
          <div class="col-span-full py-8 text-center bg-gray-50 rounded-lg border border-dashed border-gray-200">
            <p class="text-gray-500">Este autor aún no ha publicado ningún artículo.</p>
          </div>
        )}
      </div>

    </div>
  </main>

  <Footer client:load />
</Layout>

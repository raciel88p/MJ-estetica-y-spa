---
import Layout from "../../layouts/Layout.astro";
import { Navbar } from "../../components/layout/Navbar";
import { Footer } from "../../components/layout/Footer";
import { getCollection } from "astro:content";

const allAuthors = await getCollection("autores");

const authors = allAuthors.filter(a => a.data.public !== false);

function getSlug(author: any) {
    return author.id;
}
---

<Layout title="Nuestros Autores | MJ Estética Wellness Center" description="Conoce a los especialistas y autores de nuestro blog.">
  <Navbar client:load />

  <main class="min-h-screen pt-24 pb-16 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h1 class="text-4xl font-bold text-gray-900 mb-4">Conoce a nuestros Especialistas</h1>
        <p class="text-xl text-gray-600 max-w-2xl mx-auto">
          Los expertos detrás de los artículos y consejos de bienestar de MJ Estética Wellness Center.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {authors.map((author) => {
          const name = author.data.name;
          const role = author.data.role || "";
          const bio = author.data.bio || "";
          const slug = getSlug(author);

          let photoUrl = author.data.photoUrl || "/images/mj-logo.png"; // fallback

          return (
            <article class="bg-white rounded-xl shadow-sm hover:shadow-md transition-shadow duration-300 overflow-hidden border border-gray-100 flex flex-col h-full text-center">
              <div class="p-6 flex flex-col flex-grow items-center">
                <img
                  src={photoUrl}
                  alt={name}
                  class="w-32 h-32 rounded-full object-cover mb-4 border-4 border-primary/10"
                  loading="lazy"
                  decoding="async"
                />
                <a href={`/autores/${slug}`}>
                  <h2 class="text-2xl font-semibold text-gray-900 mb-1 hover:text-primary transition-colors">
                    {name}
                  </h2>
                </a>
                {role && (
                  <p class="text-sm font-medium text-primary mb-3">{role}</p>
                )}
                {bio && (
                  <p class="text-gray-600 line-clamp-3 mb-4 flex-grow">
                    {bio}
                  </p>
                )}
                <div class="mt-auto">
                  <a href={`/autores/${slug}`} class="text-primary font-medium hover:text-primary/80 transition-colors inline-flex items-center">
                    Ver perfil
                    <svg class="w-4 h-4 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                    </svg>
                  </a>
                </div>
              </div>
            </article>
          );
        })}
        {authors.length === 0 && (
          <div class="col-span-full text-center py-12">
            <p class="text-gray-500 text-lg">Aún no hay autores públicos disponibles.</p>
          </div>
        )}
      </div>
    </div>
  </main>

  <Footer client:load />
</Layout>

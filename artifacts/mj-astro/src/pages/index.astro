---
import Layout from '../layouts/Layout.astro';
import Home from '../components/pages/home';
import { sanityClient } from "sanity:client";

let latestPosts = [];
let authors = [];

try {
  [latestPosts, authors] = await Promise.all([
    sanityClient.fetch(`*[_type == "post" && language == "es"] | order(publishedAt desc)[0...3] {
      ...,
      author->
    }`),
    sanityClient.fetch(`*[_type == "author"] | order(featured desc, name asc)`)
  ]);
} catch (error) {
  console.error("Error fetching data from Sanity inside index.astro:", error);
}
---
<Layout lang="es">
  <Home client:load latestPosts={latestPosts} authors={authors} />
</Layout>

{
  "name": "MJ Fisio Estética y Spa",
  "short_name": "MJ Fisio Spa",
  "description": "Centro de estética, bienestar y tratamientos médico-estéticos en Turrialba, Costa Rica.",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#ffffff",
  "theme_color": "#1378A2",
  "lang": "es-CR",
  "icons": [
    {
      "src": "/images/logo-mj.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/images/logo-mj.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "categories": ["health", "beauty", "lifestyle"],
  "related_applications": [],
  "prefer_related_applications": false,
  "tools": [
    {
      "name": "listar-servicios",
      "description": "Lista todos los servicios y tratamientos disponibles en MJ Estética.",
      "inputSchema": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "buscar-tratamientos",
      "description": "Busca tratamientos específicos basados en palabras clave o necesidades del usuario.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "keyword": {
            "type": "string",
            "description": "Palabra clave para buscar (ej: 'facial', 'masaje', 'laser')."
          }
        },
        "required": ["keyword"]
      }
    },
    {
      "name": "enviar-sugerencia",
      "description": "Envía una sugerencia, idea o comentario al equipo de MJ Estética.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "nombre": { "type": "string", "description": "Tu nombre completo." },
          "tipo": { "type": "string", "description": "Categoría de la sugerencia." },
          "mensaje": { "type": "string", "description": "Detalle del comentario." }
        },
        "required": ["nombre", "tipo", "mensaje"]
      }
    }
  ]
}
